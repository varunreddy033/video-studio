# --- Python environment (this project folder is also the venv) ---
/bin/
/lib/
/include/
/share/
pyvenv.cfg
__pycache__/
*.pyc

# --- secrets: never commit ---
.env
.env.*
!.env.example
data/

# --- generated / large, re-created by setup.sh or the pipeline ---
output/
models/
setup.log

# --- licensed media (YouTube Audio Library): keep on this Mac, don't redistribute ---
assets/audio/

# --- macOS ---
.DS_Store

# generated character packs + shared image cache (re-made by tools/make_character_pack.py; pack.json + sheet are kept)
assets/cache/
assets/characters/*/*
!assets/characters/*/pack.json
!assets/characters/*/contact_sheet.jpg

# art style preview images (made on the Mac from the Video Studio page)
assets/style_previews/

# previews made on demand by Video Studio (voice samples, caption style clips)
assets/voice_previews/
assets/caption_previews/

# Node tools (root package.json: HyperFrames, GSAP, the icon packs), installed by npm ci
node_modules/

# icon packs (docs/ASSET_PACKS_PLAN.md): the icons, search index and embeddings are rebuilt by setup.sh from the
# pinned npm packages (tools/import_icon_packs.py, tools/build_icon_index.py). LICENCE files + CREDITS.md ARE in git.
assets/library/icons/*/icons.json
assets/library/icons/index.json
assets/library/icons/embeddings.npy

# each person's own notes for Claude Code (machine, accounts, to-dos): never shared
CLAUDE.local.md

# blocky 3D (rendering_method: blocky3d): the CC0 packs are re-downloaded by tools/fetch_blocky3d_assets.py (packs.json
# pins them); music/ holds licensed or trending tracks and never goes to git
/assets/blocky3d/*/*
/assets/blocky3d/index.json
!/assets/blocky3d/music/SOURCES.md
# the 3D explainer's own GLB models are small and in git (the models/ rule above is for the speech/ML models)
!/assets/explainer3d/models/
