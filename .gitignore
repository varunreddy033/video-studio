# --- Python environment (this project folder is also the venv) ---
/bin/
/lib/
/include/
/share/
pyvenv.cfg
__pycache__/
*.pyc

# --- secrets: never commit ---
.env
.env.*
!.env.example
old/n8n_data_backup_*.tar.gz
data/

# --- generated / large, re-created by setup.sh or the pipeline ---
output/
models/
setup.log
FastVideo/

# --- licensed media (YouTube Audio Library): keep on this Mac, don't redistribute ---
assets/audio/

# --- macOS ---
.DS_Store

# generated character packs + shared image cache (re-made by tools/make_character_pack.py; pack.json + sheet are kept)
assets/cache/
assets/characters/*/*
!assets/characters/*/pack.json
!assets/characters/*/contact_sheet.jpg

# art style preview images (made on the Mac from the Video Studio page)
assets/style_previews/

# previews made on demand by Video Studio (voice samples, caption style clips)
assets/voice_previews/
assets/caption_previews/

# Node tools of the parked HTML animation branch (f9-html-animation-wip)
node_modules/

# icon packs (docs/ASSET_PACKS_PLAN.md): the icons, search index and embeddings are rebuilt by setup.sh from the
