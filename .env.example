# Copy to .env (setup.sh does this and writes a random RENDER_TOKEN). No keys are needed.

# Port the render server listens on. Do NOT use 5000 (macOS AirPlay Receiver owns it).
PORT=8765

# Shared secret for scripts on this Mac: send it as the "X-Render-Token" header (curl) instead of logging in.
RENDER_TOKEN=change-me-to-any-long-random-string

# Images: FLUX.2 klein 4B on the Mac GPU via mflux (free, Apache-2.0, ~4.6 GB model, one image at a time)
LOCAL_IMAGE_MODEL=Runpod/FLUX.2-klein-4B-mflux-4bit
LOCAL_IMAGE_BASE=flux2-klein-4b
LOCAL_IMAGE_STEPS=4

# Voice: local Kokoro-82M
# am_michael, am_adam, am_eric, bm_george, bm_lewis, af_heart ...
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0

# whisper.cpp = the backup for word timings (Kokoro normally gives them)
WHISPER_BIN=whisper-cli
# Backup word timings. Empty = <project folder>/models/ggml-small.bin (setup.sh downloads it there).
WHISPER_MODEL=

# Mix
BGM_VOLUME=0.18
SFX_VOLUME=0.55
SFX_MAX_SEC=2.5
# Optional: force one background track (file name inside assets/audio/bgm). Empty = auto-pick a track >= 60 s.
BGM_FILE=
FPS=30
SCENE_PAD=0.35

# Hugging Face read token (optional, faster/more reliable model downloads): https://huggingface.co/settings/tokens
HF_TOKEN=
# Loudness target for the final mix (YouTube plays at about -14 LUFS)
TARGET_LUFS=-14

# Pictures for scripts without a rendering_method: line: motion (motion graphics, default) or ai_image.
# character: / [talk:] / [act:] / clip Shorts / style: motion scripts always use ai_image.
DEFAULT_RENDERING_METHOD=motion

# Motion graphics: formats show: auto may pick (empty = all 8). e.g. FORMATS_ALLOWED=tech_desk, data_lab, newsroom
FORMATS_ALLOWED=
