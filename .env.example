# Copy to .env (setup.sh does this) and fill in FAL_KEY + RENDER_TOKEN.

# Port the render server listens on. Do NOT use 5000 (macOS AirPlay Receiver owns it).
PORT=8765

# Shared secret. Put the SAME value in the n8n HTTP nodes' "X-Render-Token" header.
RENDER_TOKEN=change-me-to-any-long-random-string

# Images: fal = Flux schnell on fal.ai (cents per video)
#         local = FLUX.2 klein 4B on the Mac GPU via mflux (free, Apache-2.0, ~4.3 GB model, one image at a time)
#         placeholder = free gradient (wiring tests)
IMAGE_ENGINE=local
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
LOCAL_IMAGE_MODEL=Runpod/FLUX.2-klein-4B-mflux-4bit
LOCAL_IMAGE_BASE=flux2-klein-4b
LOCAL_IMAGE_STEPS=4

# Voice: kokoro = local Kokoro-82M | say = macOS built-in voice | silent = no voice (video test only)
VOICE_ENGINE=kokoro
# am_michael, am_adam, am_eric, bm_george, bm_lewis, af_heart ...
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0

# Captions: whisper = whisper.cpp timing | text = timed from script text | off
CAPTIONS=whisper
WHISPER_BIN=whisper-cli
WHISPER_MODEL=~/youtube-pipeline/models/ggml-small.bin

# Mix
BGM_VOLUME=0.18
SFX_VOLUME=0.55
SFX_MAX_SEC=2.5
# Optional: force one background track (file name inside assets/audio/bgm). Empty = auto-pick a track >= 60 s.
BGM_FILE=
FPS=30
SCENE_PAD=0.35

# Hugging Face read token (optional, faster/more reliable model downloads): https://huggingface.co/settings/tokens
HF_TOKEN=
# Loudness target for the final mix (YouTube plays at about -14 LUFS)
TARGET_LUFS=-14
