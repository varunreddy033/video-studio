{
  "label": "Soft glow",
  "description": "Clean capitals with a soft dark glow instead of a hard outline.",
  "licence": "Poppins (SIL Open Font License 1.1, assets/fonts/licences/poppins-OFL.txt)",
  "highlight": "none",
  "case": "upper",
  "font": "Poppins SemiBold",
  "font_file": "Poppins-SemiBold.ttf",
  "bold": false,
  "italic": false,
  "text_colour": "#FFFFFF",
  "highlight_colour": "#FFB020",
  "outline_colour": "#000000",
  "shadow_colour": "#000000",
  "shadow_transparency": 150,
  "outline_ratio": 0.07,
  "outline_min_px": 2,
  "position": "bottom-center",
  "group": {
    "max_gap_sec": 0.45,
    "break_after": ".?!:;",
    "linger_sec": 0.35,
    "min_word_sec": 0.02
  },
  "layouts": {
    "landscape": {
      "size": 0.07,
      "margin_v": 0.075,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 3,
      "max_chars": 22
    },
    "vertical": {
      "size": 0.04,
      "margin_v": 0.17,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 2,
      "max_chars": 14
    },
    "short": {
      "size": 0.058,
      "margin_v": 0.24,
      "margin_l": 0.05,
      "margin_r": 0.15,
      "max_words": 2,
      "max_chars": 12
    }
  },
  "srt": {
    "max_chars": 84,
    "line_chars": 42
  },
  "blur_ratio": 0.1,
  "shadow_ratio": 0.0
}
