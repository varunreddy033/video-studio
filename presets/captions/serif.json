{
  "label": "Serif",
  "description": "Quiet small-caps serif with a thin outline: documentaries, history.",
  "licence": "Cormorant SC (SIL Open Font License 1.1, assets/fonts/licences/cormorantsc-OFL.txt)",
  "highlight": "none",
  "case": "as_is",
  "font": "Cormorant SC SemiBold",
  "font_file": "CormorantSC-SemiBold.ttf",
  "bold": false,
  "italic": false,
  "text_colour": "#FFFFFF",
  "highlight_colour": "#FFB020",
  "outline_colour": "#000000",
  "shadow_colour": "#000000",
  "shadow_transparency": 150,
  "outline_ratio": 0.04,
  "outline_min_px": 2,
  "position": "bottom-center",
  "group": {
    "max_gap_sec": 0.45,
    "break_after": ".?!:;",
    "linger_sec": 0.35,
    "min_word_sec": 0.02
  },
  "layouts": {
    "landscape": {
      "size": 0.076,
      "margin_v": 0.075,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 4,
      "max_chars": 30
    },
    "vertical": {
      "size": 0.044,
      "margin_v": 0.17,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 3,
      "max_chars": 18
    },
    "short": {
      "size": 0.062,
      "margin_v": 0.24,
      "margin_l": 0.05,
      "margin_r": 0.15,
      "max_words": 2,
      "max_chars": 14
    }
  },
  "srt": {
    "max_chars": 84,
    "line_chars": 42
  },
  "blur_ratio": 0.03,
  "spacing_ratio": 0.03
}
