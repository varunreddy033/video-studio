{
  "label": "Comic",
  "description": "Comic-book lettering, slightly tilted, popping in two words at a time.",
  "licence": "Bangers (SIL Open Font License 1.1, assets/fonts/licences/bangers-OFL.txt)",
  "highlight": "word",
  "case": "upper",
  "font": "Bangers",
  "font_file": "Bangers-Regular.ttf",
  "bold": false,
  "italic": false,
  "text_colour": "#FFFFFF",
  "highlight_colour": "#FFD21F",
  "outline_colour": "#000000",
  "shadow_colour": "#000000",
  "shadow_transparency": 150,
  "outline_ratio": 0.12,
  "outline_min_px": 2,
  "position": "bottom-center",
  "group": {
    "max_gap_sec": 0.45,
    "break_after": ".?!:;",
    "linger_sec": 0.35,
    "min_word_sec": 0.02
  },
  "layouts": {
    "landscape": {
      "size": 0.09,
      "margin_v": 0.075,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 2,
      "max_chars": 20
    },
    "vertical": {
      "size": 0.054,
      "margin_v": 0.17,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 2,
      "max_chars": 14
    },
    "short": {
      "size": 0.078,
      "margin_v": 0.24,
      "margin_l": 0.05,
      "margin_r": 0.15,
      "max_words": 2,
      "max_chars": 12
    }
  },
  "srt": {
    "max_chars": 84,
    "line_chars": 42
  },
  "angle": 3,
  "pop": true,
  "spacing_ratio": 0.02
}
