{
  "label": "Red pop",
  "description": "Two words, tall condensed letters, the spoken word turns red.",
  "licence": "Anton (SIL Open Font License 1.1, assets/fonts/licences/anton-OFL.txt)",
  "highlight": "word",
  "case": "upper",
  "font": "Anton",
  "font_file": "Anton-Regular.ttf",
  "bold": false,
  "italic": false,
  "text_colour": "#FFFFFF",
  "highlight_colour": "#FF3B30",
  "outline_colour": "#000000",
  "shadow_colour": "#000000",
  "shadow_transparency": 150,
  "outline_ratio": 0.1,
  "outline_min_px": 2,
  "position": "bottom-center",
  "group": {
    "max_gap_sec": 0.45,
    "break_after": ".?!:;",
    "linger_sec": 0.35,
    "min_word_sec": 0.02
  },
  "layouts": {
    "landscape": {
      "size": 0.085,
      "margin_v": 0.075,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 2,
      "max_chars": 20
    },
    "vertical": {
      "size": 0.05,
      "margin_v": 0.17,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 2,
      "max_chars": 14
    },
    "short": {
      "size": 0.072,
      "margin_v": 0.24,
      "margin_l": 0.05,
      "margin_r": 0.15,
      "max_words": 2,
      "max_chars": 13
    }
  },
  "srt": {
    "max_chars": 84,
    "line_chars": 42
  },
  "pop": true
}
