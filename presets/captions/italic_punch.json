{
  "label": "Italic punch",
  "description": "Slanted condensed capitals with a drop shadow, the spoken word turns yellow.",
  "licence": "Barlow (SIL Open Font License 1.1, assets/fonts/licences/barlow-OFL.txt)",
  "highlight": "word",
  "case": "upper",
  "font": "Barlow Condensed ExtraBold",
  "font_file": "BarlowCondensed-ExtraBoldItalic.ttf",
  "bold": true,
  "italic": true,
  "text_colour": "#FFFFFF",
  "highlight_colour": "#FFE14D",
  "outline_colour": "#000000",
  "shadow_colour": "#000000",
  "shadow_transparency": 150,
  "outline_ratio": 0.08,
  "outline_min_px": 2,
  "position": "bottom-center",
  "group": {
    "max_gap_sec": 0.45,
    "break_after": ".?!:;",
    "linger_sec": 0.35,
    "min_word_sec": 0.02
  },
  "layouts": {
    "landscape": {
      "size": 0.08,
      "margin_v": 0.075,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 4,
      "max_chars": 26
    },
    "vertical": {
      "size": 0.05,
      "margin_v": 0.17,
      "margin_l": 0.06,
      "margin_r": 0.06,
      "max_words": 3,
      "max_chars": 16
    },
    "short": {
      "size": 0.07,
      "margin_v": 0.24,
      "margin_l": 0.05,
      "margin_r": 0.15,
      "max_words": 2,
      "max_chars": 13
    }
  },
  "srt": {
    "max_chars": 84,
    "line_chars": 42
  },
  "shadow_ratio": 0.07
}
